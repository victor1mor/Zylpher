ZYLPHER_ADDR=127.0.0.1:8080
ZYLPHER_DATA_DIR=/var/lib/zylpher
ZYLPHER_LOG_LEVEL=info
ZYLPHER_API_KEY=
# ZYLPHER_WEBHOOK_URL=http://127.0.0.1:9000/webhook
# ZYLPHER_WEBHOOK_SECRET=CHANGE_ME_TOO

# Midia (v1.1.0): maior anexo aceito e prazo para apagar o que ninguem buscou.
ZYLPHER_MEDIA_MAX_BYTES=16777216
ZYLPHER_MEDIA_TTL=24h
